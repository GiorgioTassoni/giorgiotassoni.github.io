---

import Icon from 'astro-iconify'

interface Props {
    role: string,
    info: string,
    desc: string,
    skills: string[],
}

const { role, info, desc, skills } = Astro.props
---

<div class="w-full grid grid-cols-12 xl:gap-1 justify-start items-center">
    <div class="col-span-12 lg:col-span-7 flex flex-col gap-2.5 px-2.5 py-5 w-fit text-neutral-300">
        <span class="text-xl md:text-2xl font-bold">{role}</span>
        <span class="text-lg lg:text-xl font-light tracking-wider">{info}</span>
        <span class="text-sm md:text-base opacity-80 lg:max-w-2xl">{desc}</span>
        <div class="pt-2.5 flex flex-row gap-2.5">
            { skills.map((skill) => (
                <div class="px-4 py-2 flex justify-center items-center rounded-2xl border border-amber-500/20
                text-neutral-300 text-sm lg:text-base overflow-hidden relative">
                    <div class="absolute w-6 h-6 bg-amber-500/50 blur-lg lg:blur-xl"></div>
                    {skill}
                </div>
            ))}
        </div>
    </div>
    <div class="col-span-5 hidden lg:flex justify-center items-center relative">
        <div class="grid place-items-center relative">
            
            <Icon 
                name="proicons:briefcase" 
                class="col-start-1 row-start-1 max-w-56 text-amber-500 blur-2xl opacity-25 z-0 scale-150"
            />

            <Icon 
                name="proicons:briefcase" 
                class="col-start-1 row-start-1 w-xs text-amber-500 relative z-10
                mask-[linear-gradient(to_bottom,black_25%,transparent_90%)]"
            />
            
        </div>
    </div>
</div>