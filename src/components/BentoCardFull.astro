---
import {Icon} from 'astro-icon/components'
import { Image } from 'astro:assets';
import SecondaryButton from './buttons/SecondaryButton.astro';
import Phone from '@/asset/Phone.png'

interface Props {
    title: string;
    desc: string;
    buttonText: string;
    iconName: string;
    href: string;
}

const { title, desc, buttonText, iconName, href } = Astro.props
---

<div class="relative flex flex-col justify-start w-full h-full border-2 
border-neutral-300/70 rounded-2xl p-4 lg:p-8 overflow-hidden duration-300 hover:border-amber-500/70">
    
    <div class="relative flex items-center justify-center w-16 h-16 shrink-0 mb-2">
        <div class="absolute w-12 h-12 bg-amber-500 opacity-60 rounded-2xl blur-xl"/>
        <Icon name={iconName} class="w-full h-full text-amber-500"/>
    </div>
    
    <div class="flex flex-col gap-1 z-10">
        <span class="text-xl md:text-2xl lg:text-3xl font-bold text-neutral-300 mb-2"> {title} </span>
        <p class="text-sm md:text-base font-normal text-neutral-300">{desc}</p>
    </div>
    <div class="w-full lg:w-full pt-5 z-10">
        <SecondaryButton
            href={href}
            label={buttonText} 
        />
    </div>
    <div class="absolute bottom-0 overflow-hidden left-0 w-full lg:flex justify-center 
    items-end pointer-events-none z-0 hidden">
        <div class="absolute w-10 h-20 bg-amber-500 rounded-2xl blur-3xl"/>
        <Image 
            src={Phone}
            alt="PhoneImg"
            class="w-100 h-auto opacity-70 mask-[linear-gradient(to_top,transparent_0%,black_30%)]"
        />
    </div>

</div>