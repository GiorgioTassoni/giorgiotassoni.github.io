---
import {Icon} from 'astro-icon/components'
import PageSelector from '../PageSelector.astro';
---
<header class="px-2 md:max-w-5/6 lg:max-w-4/5 mx-auto flex flex-row justify-center items-center w-full z-50">
    <nav class="w-full bg-neutral-300/5 shadow-xl rounded-2xl px-10 py-3
                flex flex-row lg:justify-between justify-center items-center">
        <div class="lg:flex flex-row gap-2.5 items-center hidden">
            <Icon name="proicons:code-square" class="text-2xl text-amber-500" />
            <span class="text-lg text-neutral-300">Giorgio Tassoni</span>
        </div>

        <div class="flex flex-row md:gap-20 xl:gap-5 items-center">
            <PageSelector href='/'label="About" />
            <PageSelector href="/contact" label="Contact" />
        </div>
        <a href="https://github.com/GiorgioTassoni" target="_blank" class="lg:block hidden">
            <Icon name="proicons:github" class="text-3xl text-neutral-300 cursor-pointer" />
        </a>
    </nav>
</header>


