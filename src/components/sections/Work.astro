---
import WorkCard from "../WorkCard.astro";

---

<div>
    <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-neutral-300">Work <span class="text-amber-500">Experience</span></h2>
    <WorkCard 
    role="Game Developer"
    info="Behaveme | 2025-2026"
    desc="Developed and designed a “Serious Game” using Unity3D (C#/.NET) used 
    to assess candidates' coding skills. Engineered a fully modular and maintainable architecture,
     integrating external APIs to manage assessment data."
    skills={ ["C# .NET", "Unity 3D", "Game Design"]}
    />
</div>