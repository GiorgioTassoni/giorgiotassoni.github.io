---
import Icon from "astro-iconify";
import ContactForm from "../ContactForm.astro";

---

<div class="w-full flex flex-col gap-10 justify-center pt-30 lg:pt-5 items-start text-start">
    <div class="w-full grid grid-cols-12 gap-2 lg:gap-30">
        <div class="flex flex-col gap-5 w-full col-span-12 lg:col-span-7">
                <div>
                    <span class="text-base md:text-xl lg:text-2xl text-neutral-300 lg:pl-2 animate-in delay-200">Drop me a message,</span>
                    <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold bg-clip-text text-transparent bg-linear-to-r
                     from-amber-500 to-amber-300 pb-2.5
                    hover:brightness-110 transition-all duration-300 animate-in delay-100">
                        LET'S KNOW <br>
                        EACH OTHER
                    </h1>
                </div>
                <span class="text-base lg:text-xl text-neutral-300 pl-2 max-w-lg hidden animate-in delay-200">You have a project idea or just want to say hello?
                    Drop me an email or send me a DM on LinkedIn I'll get back to you as fast as I can</span>
                <ContactForm />
        </div>
        <div class="hidden 2xl:grid place-items-center col-span-0 lg:col-span-5 w-full text-amber-500 
        -rotate-5 animate-in delay-400">
            <Icon name="proicons:mail" class="lg:max-w-lg col-start-1 row-start-1 
            mask-[linear-gradient(to_bottom,black_50%,transparent_90%)]" />
            <Icon name="proicons:mail" class="lg:max-w-lg col-start-1 row-start-1 blur-2xl opacity-25" />
        </div>
    </div>
</div>
