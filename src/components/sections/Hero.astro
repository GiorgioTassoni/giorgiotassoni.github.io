---
import { Image } from 'astro:assets';
import {Icon} from 'astro-icon/components'
import laureaImage from "@/asset/ImageFinishedcropped.png"
import PrimaryButton from '../buttons/PrimaryButton.astro';
import SecondaryButton from '../buttons/SecondaryButton.astro';
---

<div class="w-full flex flex-col justify-center pt-30 lg:pt-5">
    <div class="flex flex-row w-full justify-between items-center">
        <div class="flex flex-col gap-2 lg:gap-4">
            <div>
                <span class="text-lg md:text-xl lg:text-3xl font-mono text-neutral-300 pl-2 animate-in delay-100">Hello world! I'm</span>
                <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold bg-clip-text text-transparent bg-linear-to-r 
                from-amber-500 to-amber-300 pb-2
                hover:brightness-110 transition-all duration-300 animate-in delay-100">
                    Giorgio Tassoni
                </h1>
            </div>
            <span class="text-base md:text-lg lg:text-lg text-neutral-300 pl-2 animate-in delay-200">Full-stack & Game developer</span>
            <div class="flex flex-col max-w-50 md:max-w-80 lg:max-w-120 lg:w-full lg:flex-row gap-3 lg:gap-6 mt-2 animate-in delay-200">
                <PrimaryButton label='Download CV' href='/CVGiorgioTassoni.pdf' download="CVGiorgioTassoni.pdf"/>
                <SecondaryButton label='Send me an Email' href='contact'/>
            </div>
        </div>
        <div class="relative animate-in delay-300 hidden lg:block">
            <Image 
                src={laureaImage}
                alt="Giorgio Tassoni Laurea"
                class="w-90 h-auto translate-y-5 mask-[linear-gradient(to_top,transparent_0%,black_30%)]"
            />
        </div>
    </div>
    <div class="hidden lg:flex justify-center items-center animate-in delay-400">
        <Icon name={"proicons:arrow-down"} class="text-4xl text-neutral-300/50 animate-bounce duration-600"></Icon>
    </div>
</div>
