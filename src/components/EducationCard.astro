---
import Icon from 'astro-iconify'
---

<div class="w-full grid grid-cols-12 xl:gap-1 justify-start items-center">
    <div class="col-span-12 lg:col-span-7 flex flex-col gap-2.5 px-2 py-5 w-fit text-neutral-300">
        <div class="flex flex-col gap-2.5 py-5">
            <h3 class="text-xl md:text-2xl font-bold">University of Camerino</h3>
            <span class="text-lg md:text-xl font-light tracking-normal lg:tracking-wider">B.Sc. in Computer Science | Grade: 107</span>
            <span class="md:text-base text-amber-500">Relevant Coursework</span>
            <ul class="text-sm md:text-base list-disc list-inside flex flex-col gap-2 ml-2 text-neutral-300 marker:text-neutral-300">
                <li><span class="font-bold">Software Engineering:</span> Advanced Design Patterns & Software Architectures.</li>
                <li><span class="font-bold">Advanced Programming:</span> Functional & Object-Oriented paradigms</li>
                <li><span class="font-bold">Clean Coding:</span> Deep dive into SOLID principles and agile methodologies</li>
            </ul>
        </div>
        <div class="flex flex-col gap-2.5 py-5">
            <h3 class="text-xl lg:text-2xl font-bold">Liceo Scientifico A. Einstein</h3>
            <span class="text-lg lg:text-xl font-light tracking-normal lg:tracking-wider">High School Diploma</span>
        </div>
    </div>
    <div class="col-span-5 hidden lg:flex justify-center items-center relative">
        <div class="grid place-items-center relative">
                
            <Icon 
                  name="proicons:hat-graduation" 
                 class="col-start-1 row-start-1 max-w-56 text-amber-500 blur-2xl opacity-25 z-0 scale-150"
            />

            <Icon 
                name="proicons:hat-graduation" 
                class="col-start-1 row-start-1 w-xs text-amber-500 relative z-10
                mask-[linear-gradient(to_bottom,black_25%,transparent_90%)]"
            />
        </div>
    </div>
</div>