---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/sections/Hero.astro";
import ProjectSection from "@/components/sections/ProjectSection.astro";
import Work from "@/components/sections/Work.astro";
import Education from "@/components/sections/Education.astro";
import FooterSection from "@/components/sections/FooterSection.astro";
---

<Layout title="Giorgio Tassoni | Portfolio">
    <section id="hero" class="w-full h-screen">
        <Hero />
    </section>
    
    <div class="flex flex-col gap-40">
        <section id="projects">
            <ProjectSection />
        </section>

        <section id="work">
            <Work />
        </section>

        <section id="education">
            <Education />
        </section>
    </div>

    <footer slot="footer" class="w-full lg:max-w-3/4 px-6">
        <FooterSection />
    </footer>
</Layout>